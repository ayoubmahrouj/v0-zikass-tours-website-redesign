# =============================================================================
# ZikassTours — variables d'environnement
# Copier ce fichier en .env.local (local) et l'ajouter dans Vercel (production).
# =============================================================================

# --- Analytics (le code ne charge rien si ces valeurs sont vides) ------------
# Google Analytics 4 : Admin > Flux de données > ID de mesure (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Meta (Facebook/Instagram) Pixel : Gestionnaire d'événements > ID du pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity (heatmaps + enregistrements) : clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# Search Console : balise meta de vérification (optionnel)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Base de données (réservations + avis) ----------------------------------
# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin / réservations ----------------------------------------------------
# Mot de passe du tableau de bord /admin
ADMIN_PASSWORD=

# Notification WhatsApp à chaque nouvelle réservation (CallMeBot)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
